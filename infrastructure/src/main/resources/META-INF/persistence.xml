<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="POSTGRES_NBD_BANK_PU" transaction-type="RESOURCE_LOCAL">
      <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

      <class>pl.nbd.infrastructure.entities.client.ClientEntity</class>
      <class>pl.nbd.infrastructure.entities.account.AccountEntity</class>

      <exclude-unlisted-classes>true</exclude-unlisted-classes>

      <properties>
          <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
          <property name="hibernate.connection.url" value="jdbc:postgresql://localhost:5432/postgres"/>
          <property name="hibernate.connection.username" value="nbd"/>
          <property name="hibernate.connection.password" value="nbdpassword"/>
          <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create" />
          <property name="hibernate.show_sql" value="true" />
          <property name="hibernate.format_sql" value="true" />
      </properties>
  </persistence-unit>
</persistence>
